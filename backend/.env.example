# Backend Environment Variables
APP_ENV=development
APP_NAME="QUANTLAB API"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (SQLite for local development, PostgreSQL ready for production)
DATABASE_URL=sqlite:///./quantlab.db

# JWT Authentication & Security
SECRET_KEY=change-me-in-local-environment-to-a-secure-secret-key-at-least-32-chars
JWT_SECRET_KEY=change-me-in-local-environment-to-a-secure-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
