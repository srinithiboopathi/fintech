# Backend Environment Variables
APP_ENV=development
APP_NAME="QUANTLAB API"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (Placeholder for Phase 15)
DATABASE_URL=postgresql://quantlab_user:quantlab_password@localhost:5432/quantlab_db

# Security & Secrets (Placeholder for Phase 14 MAID Integration)
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
