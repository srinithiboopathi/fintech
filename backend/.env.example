# Market Data Provider Configuration
PRIMARY_PROVIDER=twelve_data
FALLBACK_PROVIDER=alpha_vantage

# Twelve Data Configuration (Primary)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Alpha Vantage Configuration (Fallback)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Local Cache Settings (Limits API consumption)
HISTORICAL_CACHE_TTL_HOURS=24
LATEST_CACHE_TTL_SECONDS=60

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
